# =====================================================================
# CẤU HÌNH CRAWLER TTHC & XUẤT BẢN DỮ LIỆU (ENVIRONMENT CONFIG)
# =====================================================================

# ---------------------------------------------------------------------
# 1. CẤU HÌNH UPLOAD REPOSITORY (GIT & GITHUB)
# ---------------------------------------------------------------------
# Bật/tắt tự động upload Git (true = Cho phép push, false = Không push)
UPLOAD_REPO=true

# Tên tài khoản GitHub của bạn
GITHUB_USERNAME=duynghiaqn

# Đường dẫn Repository trên GitHub (định dạng: owner/repo)
GITHUB_REPOSITORY=duynghiaqn/Crawler-TTHC

# Thông tin tác giả ghi vào nhật ký git commit tự động
GIT_USER_NAME=Crawler KYN Bot
GIT_USER_EMAIL=23546317+duynghiaqn@users.noreply.github.com

# Tên remote Git (Mặc định: origin)
GIT_REMOTE_NAME=origin

# Đường dẫn URL remote tùy chỉnh (để trống để tự động nhận diện từ git remote get-url)
GIT_REMOTE_URL=

# Token xác thực GitHub Personal Access Token (PAT) (Bắt buộc nếu cần đẩy code tự động lên GitHub)
# Tạo token tại: GitHub -> Settings -> Developer Settings -> Personal access tokens (Tokens classic, chọn quyền 'repo')
# Ví dụ: GITHUB_TOKEN=ghp_YourGitHubPersonalAccessToken
GITHUB_TOKEN=

# Tên các nhánh đích
GIT_MAIN_BRANCH=main
GIT_DATA_BRANCH=data
GIT_DATA_GL_BRANCH=data-gl

# ---------------------------------------------------------------------
# 2. CẤU HÌNH THÔNG BÁO TELEGRAM (BOT NOTIFICATION)
# ---------------------------------------------------------------------
# Bật/tắt gửi thông báo Telegram (true = bật, false = tắt)
TELEGRAM_ENABLE=true

# Token Bot từ @BotFather (ví dụ: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Chat ID nhận thông báo (lấy từ bot @userinfobot hoặc ID group/kênh: -100xxxxxxx)
TELEGRAM_CHAT_ID=

# Thread ID nếu gửi tin nhắn vào Topic cụ thể trong Supergroup Forum (để trống nếu không dùng)
TELEGRAM_TOPIC_ID=

# ---------------------------------------------------------------------
# 3. CẤU HÌNH CẢNH BÁO BIẾN ĐỘNG GOOGLE APPS SCRIPT (GAS WEBHOOK)
# ---------------------------------------------------------------------
# URL Webhook của Google Apps Script để nhận thông báo biến động TTHC cấp Tỉnh/Gia Lai
# Ví dụ: https://script.google.com/macros/s/AKfycbx.../exec
GAS_WEBHOOK_URL=

# Khóa bí mật xác thực webhook (nếu triển khai GAS có kiểm tra token/secret)
GAS_SECRET_KEY=

# Ép buộc gửi thông báo cảnh báo ngay cả khi không có biến động dữ liệu (true = ép gửi, false = chỉ gửi khi có thay đổi)
FORCE_ALERT=false

# ---------------------------------------------------------------------
# 4. CẤU HÌNH HIỆU NĂNG CRAWLER (PERFORMANCE & CONCURRENCY)
# ---------------------------------------------------------------------
# Số kết nối song song tối đa đồng thời (Mặc định: 5)
MAX_CONCURRENCY=5


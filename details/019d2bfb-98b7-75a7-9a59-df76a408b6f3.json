{
  "id": "019d2bfb-98b7-75a7-9a59-df76a408b6f3",
  "code": "1.013275",
  "codeNotation": "1.013275",
  "executionSteps": [
    {
      "name": "a) Nộp hồ sơ thủ tục hành chính:",
      "description": "Tổ chức, cá nhân gửi 01 hồ sơ đề nghị phê duyệt vị trí cảng hàng không chuyên dùng và bãi cất, hạ cánh đến Bộ Quốc phòng (Cục Tác chiến, Bộ Tổng Tham mưu)."
    },
    {
      "name": "b) Giải quyết thủ tục hành chính:",
      "description": "- Trường hợp phải sửa đổi, bổ sung hồ sơ, trong thời hạn 05 ngày làm việc kể từ ngày nhận được hồ sơ, Bộ Quốc phòng có văn bản yêu cầu tổ chức, cá nhân hoàn thiện hồ sơ theo quy định."
    },
    {
      "name": "",
      "description": "- Trong thời hạn 07 ngày làm việc kể từ ngày nhận đủ hồ sơ hợp lệ theo quy định, Bộ Quốc phòng gửi văn bản lấy ý kiến thống nhất của Bộ Công an, Bộ Xây dựng, Ủy ban nhân dân cấp tỉnh về vị trí cảng hàng không chuyên dùng và bãi cất, hạ cánh. Trong thời hạn 10 ngày làm việc, kể từ ngày nhận được văn bản lấy ý kiến của Bộ Quốc phòng, Bộ Công an, Bộ Xây dựng và Ủy ban nhân dân cấp tỉnh có văn bản trả lời gửi Bộ Quốc phòng."
    },
    {
      "name": "",
      "description": "- Trong thời hạn 10 ngày làm việc, kể từ ngày nhận được văn bản thống nhất của Bộ Công an, Bộ Xây dựng, Ủy ban nhân dân cấp tỉnh, Bộ Quốc phòng ra quyết định phê duyệt vị trí cảng hàng không chuyên dùng và bãi cất, hạ cánh; trường hợp không chấp thuận, Bộ Quốc phòng phải có văn bản thông báo, nêu rõ lý do."
    },
    {
      "name": "",
      "description": "Kết quả giải quyết thủ tục hành chính được trả bằng bản điện tử, trừ trường hợp công dân, tổ chức có nhu cầu nhận bản giấy. Hồ sơ và kết quả giải quyết thủ tục hành chính bằng bản điện tử có giá trị pháp lý như bản giấy."
    }
  ],

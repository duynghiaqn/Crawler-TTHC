{
  "id": "019d2bfb-98c2-728b-bd24-f7835b894207",
  "code": "1.013284",
  "codeNotation": "1.013284",
  "executionSteps": [
    {
      "name": "a) Nộp hồ sơ thủ tục hành chính:",
      "description": "Chủ sở hữu bãi cất, hạ cánh nộp hồ sơ đề nghị mở lại bãi cất, hạ cánh đến Cục Tác chiến, Bộ Tổng Tham mưu bằng hình thức trực tiếp, Bộ phận Một cửa Bộ Quốc phòng hoặc qua dịch vụ bưu chính hoặc trực tuyến qua Cổng Dịch vụ công Quốc gia hoặc Hệ thống thông tin giải quyết thủ tục hành chính Bộ Quốc phòng."
    },
    {
      "name": "b) Giải quyết thủ tục hành chính:",
      "description": "- Trong thời hạn 10 ngày làm việc, kể từ ngày nhận đủ hồ sơ hợp lệ theo quy định, Cục Tác chiến, Bộ Tổng Tham mưu có trách nhiệm thẩm định, kiểm tra, báo cáo Bộ Tổng Tham mưu gửi văn bản lấy ý kiến thống nhất của Bộ Xây dựng, Ủy ban nhân dân cấp tỉnh nơi mở bãi cất, hạ cánh trên mặt đất, mặt nước."
    },
    {
      "name": "",
      "description": "- Trường hợp hồ sơ không hợp lệ, trong thời hạn 05 ngày làm việc, kể từ ngày nhận hồ sơ, Cục Tác chiến, Bộ Tổng Tham mưu có văn bản yêu cầu tổ chức, cá nhân đề nghị mở lại bãi cất, hạ cánh hoàn thiện hồ sơ theo quy định."
    },
    {
      "name": "",
      "description": "- Trong thời hạn 07 ngày làm việc, kể từ ngày nhận văn bản đề nghị của Bộ Tổng Tham mưu, Bộ Xây dựng, Ủy ban nhân dân cấp tỉnh có văn bản trả lời gửi Bộ Tổng Tham mưu."
    },
    {
      "name": "",
      "description": "- Trong thời hạn 10 ngày làm việc, kể từ ngày nhận được văn bản thống nhất của Bộ Xây dựng, Ủy ban nhân dân cấp tỉnh, Bộ Tổng Tham mưu ra văn bản mở lại bãi cất, hạ cánh. Trường hợp không chấp thuận, Bộ Tổng Tham mưu có văn bản trả lời, nêu rõ lý do."
    },
    {
      "name": "",
      "description": "Kết quả giải quyết thủ tục hành chính được trả bằng bản điện tử, trừ trường hợp công dân, tổ chức có nhu cầu nhận bản giấy. Hồ sơ và kết quả giải quyết thủ tục hành chính bằng bản điện tử có giá trị pháp lý như bản giấy."
    }
  ],

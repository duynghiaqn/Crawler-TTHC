        {
          "id": "019d2bf8-0bd9-73c8-a991-0174efcac9d0",
          "ma_tthc": "1.013779",
          "ten_tthc": "Thủ tục cấp Giấy phép cho thương nhân được ký hợp đồng đại lý mua, bán hàng hóa xuất khẩu theo giấy phép",
          "linh_vuc": [
            "Công nghiệp tiêu dùng"

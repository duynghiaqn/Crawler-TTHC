          "ma_tthc": "2.001757",
          "ten_tthc": "Cấp giấy phép lắp đặt cáp viễn thông trên biển",
          "linh_vuc": [
            "Viễn thông và Internet"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bf9-9bad-701b-85f4-641c34116bcd"
        },
        {
          "id": "019d2bf9-64a6-74b7-9ac9-ef766c6a7425",
          "ma_tthc": "1.013908",
          "ten_tthc": "Thu hồi giấy phép cung cấp dịch vụ viễn thông không có hạ tầng mạng, loại hình dịch vụ viễn thông cố định mặt đất (dịch vụ viễn thông cung cấp trên mạng viễn thông cố định mặt đất) và giấy chứng nhận đăng ký cung cấp dịch vụ viễn thông",
          "linh_vuc": [
            "Viễn thông và Internet"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bf9-64a6-74b7-9ac9-ef766c6a7425"
        },
        {
          "id": "019d2bf9-649d-765c-81f8-371e1c0afd08",
          "ma_tthc": "1.013909",
          "ten_tthc": "Thu hồi giấy phép cung cấp dịch vụ viễn thông có hạ tầng mạng, loại mạng viễn thông công cộng cố định mặt đất không sử dụng băng tần số vô tuyến điện, không sử dụng số thuê bao viễn thông có phạm vi thiết lập mạng viễn thông trong một tỉnh, thành phố trực thuộc trung ương",

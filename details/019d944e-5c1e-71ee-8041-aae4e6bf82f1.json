  "tthc_kem_theo": {
    "cong_khai_moi": {
      "count": 10,
      "items": [
        {
          "id": "019df268-8826-7605-aa11-d890504340f2",
          "ma_tthc": "3.000556",
          "ten_tthc": "Thủ tục Hỗ trợ tu bổ, sửa chữa nhà ở mang kiểu dáng kiến trúc truyền thống của vùng đồng bằng Bắc Bộ, có giá trị trong việc bảo tồn văn hóa lịch sử trong vùng lõi Di sản văn hóa và thiên nhiên thế giới Quần thể danh thắng Tràng An để phục vụ hoạt động du lịch",
          "linh_vuc": [],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019df268-8826-7605-aa11-d890504340f2"
        },
        {
          "id": "019df263-0468-75b4-ac40-ce151c3de74c",
          "ma_tthc": "3.000555",
          "ten_tthc": "Thủ tục Hỗ trợ xây dựng mới nhà ở (theo khung mẫu thiết kế) trong vùng lõi Di sản văn hóa và thiên nhiên thế giới Quần thể danh thắng Tràng An",
          "linh_vuc": [],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019df263-0468-75b4-ac40-ce151c3de74c"
        },
        {
          "id": "019df259-0e85-7089-bacd-37576c96d30d",
          "ma_tthc": "3.000554",
          "ten_tthc": "Thủ tục Hỗ trợ duy trì hoạt động của các đội văn nghệ, câu lạc bộ văn nghệ quần chúng tại các địa phương để phục vụ khách du lịch và các hoạt động, sự kiện du lịch của tỉnh",
          "linh_vuc": [],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019df259-0e85-7089-bacd-37576c96d30d"
        },
        {
          "id": "019df24d-565c-724f-b73c-748d6ceb94ca",
          "ma_tthc": "3.000553",
          "ten_tthc": "Thủ tục hỗ trợ thành lập mới các đội văn nghệ, câu lạc bộ văn nghệ quần chúng tại các địa phương để phục vụ khách du lịch và các hoạt động sự kiện du lịch của tỉnh",
          "linh_vuc": [],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019df24d-565c-724f-b73c-748d6ceb94ca"
        },
        {
          "id": "019df247-a369-752b-b581-218b82ce4d56",
          "ma_tthc": "3.000552",
          "ten_tthc": "Thủ tục Hỗ trợ đầu tư xây dựng mới hoặc nâng cấp, cải tạo loại hình nhà ở có phòng cho khách du lịch thuê (gọi theo tiếng Anh là homestay)",
          "linh_vuc": [],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019df247-a369-752b-b581-218b82ce4d56"
        },
        {
          "id": "019dbd2f-28cb-735f-b383-e49970bd0513",
          "ma_tthc": "3.000551",
          "ten_tthc": "Thủ tục Hỗ trợ tổ chức các chương trình biểu diễn nghệ thuật góp phần thu hút khách du lịch",
          "linh_vuc": [],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019dbd2f-28cb-735f-b383-e49970bd0513"
        },
        {
          "id": "019dbd24-7702-70eb-ba7a-f85b060c7c83",
          "ma_tthc": "3.000550",
          "ten_tthc": "Thủ tục Hỗ trợ phát triển sản phẩm du lịch mới",
          "linh_vuc": [],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",

  "executionSteps": [
    {
      "name": "",
      "description": "+ Bộ Quốc phòng, Bộ Công an đề nghị đóng luồng phải thông báo bằng văn bản nêu rõ lý do đóng luồng, thời điểm đóng luồng gửi Ủy ban nhân dân cấp tỉnh. Thời gian thông báo trước thời điểm yêu cầu đóng luồng ít nhất 30 ngày. \n+ Chậm nhất trong 05 ngày làm việc, kể từ ngày nhận được văn bản đề nghị, Ủy ban nhân dân cấp tỉnh quyết định công bố đóng luồng đường thủy nội địa trong địa giới hành chính địa phương."
    }
  ],

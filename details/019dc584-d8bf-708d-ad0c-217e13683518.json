        {
          "id": "019dbda3-3a05-75dc-82c8-f2b3eda0371f",
          "ma_tthc": "1.115078",
          "ten_tthc": "Trợ giúp xã hội khẩn cấp cho người bị bệnh hiểm nghèo thuộc hộ nghèo, hộ cận nghèo và hộ có mức sống trung bình (UBND xã phường)",
          "linh_vuc": [
            "Bảo trợ xã hội"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019dbda3-3a05-75dc-82c8-f2b3eda0371f"
        },
        {
          "id": "019dbd66-8f92-76e8-a2ed-18c427a066dd",
          "ma_tthc": "1.115077",
          "ten_tthc": "Chính sách hỗ trợ phẫu thuật tim cho trẻ em bị bệnh tim bẩm sinh",
          "linh_vuc": [
            "Trẻ em"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019dbd66-8f92-76e8-a2ed-18c427a066dd"
        },
        {
          "id": "019dbd44-83df-72cd-b0bd-c0629d51a884",
          "ma_tthc": "1.115076",
          "ten_tthc": "Thủ tục thực hiện, điều chỉnh, thôi hưởng trợ cấp xã hội hàng tháng cho người cao tuổi từ đủ 75 tuổi đến 80 tuổi mà không có lương hưu, trợ cấp bảo hiểm xã hội hàng tháng, trợ cấp xã hội hàng tháng; Người mắc bệnh ung thư, suy thận mãn chạy thận nhân tạo có giấy chứng nhận của cơ quan y tế có thẩm quyền mà không có lương hưu, tiền lương, trợ cấp bảo hiểm xã hội hàng tháng, trợ cấp xã hội hàng tháng; Người khuyết tật nhẹ là thế hệ thứ ba của người hoạt động kháng chiến bị nhiễm chất độc hóa học",
          "linh_vuc": [
            "Bảo trợ xã hội"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019dbd44-83df-72cd-b0bd-c0629d51a884"
        },
        {
          "id": "019dbd3d-9aff-7268-b815-326f1ce394a3",
          "ma_tthc": "1.115075",
          "ten_tthc": "Hỗ trợ chi phí mai táng cho người cao tuổi từ đủ 75 tuổi đến 80 tuổi mà không có lương hưu, trợ cấp bảo hiểm xã hội hàng tháng, trợ cấp xã hội hàng tháng; Người mắc bệnh ung thư, suy thận mãn chạy thận nhân tạo có giấy chứng nhận của cơ quan y tế có thẩm quyền mà không có lương hưu, tiền lương, trợ cấp bảo hiểm xã hội hàng tháng, trợ cấp xã hội hàng tháng; Người khuyết tật nhẹ là thế hệ thứ ba của người hoạt động kháng chiến bị nhiễm chất độc hóa học",

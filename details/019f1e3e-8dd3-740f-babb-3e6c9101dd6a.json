  "executionSteps": [
    {
      "name": "Nộp hồ sơ thủ tục hành chính",
      "description": "Người đề nghị cấp lại Giấy chứng nhận đủ điều kiện sức khỏe gửi hồ sơ trực tiếp tại Bộ phận Một cửa Cục Hàng không Việt Nam hoặc qua dịch vụ bưu chính hoặc trên Cổng Dịch vụ công quốc gia."
    },
    {
      "name": "Giải quyết thủ tục hành chính",
      "description": "Trong thời hạn 05 ngày làm việc kể từ ngày nhận hồ sơ đầy đủ theo quy định, Cục Hàng không Việt Nam cấp lại giấy chứng nhận hoặc thông báo từ chối cấp, nêu rõ lý do.\n Kết quả giải quyết thủ tục hành chính được trả bằng bản điện tử, trừ trường hợp công dân, tổ chức có nhu cầu nhận bản giấy. Hồ sơ và kết quả giải quyết thủ tục hành chính bằng bản điện tử có giá trị pháp lý như bản giấy."
    }
  ],

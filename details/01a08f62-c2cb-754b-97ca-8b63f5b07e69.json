        },
        {
          "id": "01a08f8a-597e-71ca-b339-a498266c0afa",
          "ma_tthc": "1.116615",
          "ten_tthc": "Hỗ trợ sản xuất mẫu thử, mua công nghệ và đổi mới công nghệ theo quy định của pháp luật về chuyển giao công nghệ của dự án cho doanh nghiệp thực hiện dự án sản xuất sản phẩm phụ trợ trực tiếp trong công nghiệp bán dẫn trên địa bàn thành phố Cần Thơ (TPCT)",
          "linh_vuc": [],
          "ngay_hieu_luc": "2026-09-10",

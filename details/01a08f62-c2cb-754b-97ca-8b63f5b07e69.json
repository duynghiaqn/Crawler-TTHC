        {
          "id": "01a08f8f-8357-779b-904b-e0c81ec1f790",
          "ma_tthc": "1.116616",
          "ten_tthc": "Hỗ trợ sản xuất mẫu thử, mua công nghệ và đổi mới công nghệ theo quy định của pháp luật về chuyển giao công nghệ của dự án cho doanh nghiệp thực hiện dự án sản xuất thiết bị điện tử trên địa bàn thành phố Cần Thơ (TPCT)",
          "linh_vuc": [],

  "executionSteps": [
    {
      "name": "",
      "description": "Trong trường hợp thương nhân không thực hiện được chỉ tiêu ủy thác đã được phân bổ, trong thời hạn 03 ngày kể từ ngày có thông báo của Ủy ban nhân dân cấp tỉnh theo quy định tại khoản 5 Điều 7 của Thông tư này, thương nhân phải có văn bản báo cáo gửi về Ủy ban nhân dân cấp tỉnh về việc trả lại phần chỉ tiêu không thực hiện được đồng thời sao gửi về Bộ Công Thương. Ủy ban nhân dân cấp tỉnh tổng hợp chỉ tiêu trả lại của thương nhân và có văn bản gửi Bộ Công Thương."
    }
  ],
  "executionMethods": [

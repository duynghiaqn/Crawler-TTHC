{
  "id": "01a19a7e-f1fe-7542-94f2-0c502ffa3576",
  "code": "6.006795",
  "codeNotation": "6.006795",
  "executionSteps": [
    {
      "name": "Bước 1",
      "description": "Ủy ban nhân dân cấp xã đề xuất Kế hoạch phát triển chợ theo giai đoạn trên địa bàn cấp xã gửi về Sở Công Thương tổng hợp."
    },
    {
      "name": "Bước 2",
      "description": "Sở Công Thương căn cứ Quy hoạch, nhu cầu phát triển chợ, Kế hoạch phát triển kinh tế - xã hội của thành phố; đề xuất của Ủy ban nhân dân cấp xã về Kế hoạch phát triển chợ trên địa bàn và các văn bản khác liên quan, lập Dự thảo Kế hoạch phát triển chợ theo giai đoạn trên địa bàn thành phố (gọi tắt là Kế hoạch) trong thời hạn 20 ngày và lấy ý kiến của các cơ quan, đơn vị liên quan."
    },
    {
      "name": "Bước 3",
      "description": "Trong thời hạn 15 ngày, các cơ quan có liên quan có trách nhiệm góp ý Dự thảo Kế hoạch gửi về Sở Công Thương."
    },
    {
      "name": "Bước 4",
      "description": "Trên cơ sở ý kiến của các cơ quan, đơn vị, Sở Công Thương tổng hợp, giải trình các ý kiến tham gia góp ý của các cơ quan đơn vị, hoàn thiện và trình Ủy ban nhân dân thành phố phê duyệt Dự thảo Kế hoạch trong thời hạn 20 ngày. Trong trường hợp cần thiết phải lấy ý kiến Dự thảo Kế hoạch lần 2, thời hạn tối đa không quá 15 ngày."
    },
    {
      "name": "Bước 5",
      "description": "Uỷ ban nhân dân thành phố xem xét, phê duyệt Kế hoạch trong thời hạn theo Quy chế làm việc của Ủy ban nhân dân thành phố."
    }
  ],

{
  "id": "01a1c350-b999-7039-b060-8e878194d298",
  "code": "6.006812",
  "codeNotation": "6.006812",
  "executionSteps": [
    {
      "name": "Bước 1",
      "description": "Căn cứ thành tích đạt được của cá nhân; cơ quan, đơn vị, địa phương thực hiện các nội dung:\nLập hồ sơ đề nghị khen thưởng;\nXin ý kiến các cơ quan đơn vị có liên quan (nếu có);\nĐề nghị Chủ tịch Ủy ban nhân dân thành phố khen thưởng gửi Sở Nội vụ đối với các trường hợp đủ điều kiện, tiêu chuẩn khen thưởng."
    },
    {
      "name": "Bước 2",
      "description": "Trên cơ sở hồ sơ đề nghị khen thưởng của các cơ quan, đơn vị, địa phương, trong thời hạn 20 ngày làm việc kể từ ngày nhận đủ hồ sơ theo quy định, Sở Nội vụ thực hiện thẩm định hồ sơ và chuẩn bị các nội dung phục vụ cho Hội đồng Thi đua - Khen thưởng thành phố xét duyệt các danh hiệu thi đua, hình thức khen thưởng theo quy định. Trên cơ sở kết quả xét duyệt của Hội đồng Thi đua - Khen thưởng thành phố, tổng hợp, trình Chủ tịch Ủy ban nhân dân thành phố quyết định đối với các trường hợp đủ điều kiện, tiêu chuẩn khen thưởng."
    },
    {
      "name": "Bước 3",
      "description": "Trên cơ sở đề nghị của Sở Nội vụ, trong thời hạn 05 ngày làm việc, Chủ tịch Ủy ban nhân dân thành phố xem xét, quyết định khen thưởng theo quy định."
    }
  ],

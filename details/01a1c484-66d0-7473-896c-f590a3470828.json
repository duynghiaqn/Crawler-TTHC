        },
        {
          "id": "019d2bfd-ebfb-75dd-be92-204f71d96704",
          "ma_tthc": "1.011659",
          "ten_tthc": "Phê duyệt biểu mức và phương thức thanh toán tiền bản quyền do tổ chức đại diện tập thể quyền tác giả, quyền liên quan xây dựng",
          "linh_vuc": [
            "Bản quyền tác giả"
          ],
          "ngay_hieu_luc": "2026-10-30",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bfd-ebfb-75dd-be92-204f71d96704"
        },
        {
          "id": "019d2bfd-ebfb-7235-b65f-a8ba01794490",
          "ma_tthc": "1.011657",
          "ten_tthc": "Chấp thuận việc khai thác, sử dụng quyền dịch các tác phẩm từ tiếng nước ngoài sang tiếng Việt để giảng dạy, nghiên cứu không nhằm mục đích thương mại",
          "linh_vuc": [
            "Bản quyền tác giả"
          ],
          "ngay_hieu_luc": "2026-10-30",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bfd-ebfb-7235-b65f-a8ba01794490"
        },
        {
          "id": "019d2bfd-ebf7-73db-a734-883ab80e44ab",
          "ma_tthc": "1.011655",
          "ten_tthc": "Thủ tục chấp thuận sử dụng tác phẩm, cuộc biểu diễn, bản ghi âm, ghi hình, chương trình phát sóng mà Nhà nước là đại diện quản lý quyền tác giả, chủ sở hữu quyền liên quan",
          "linh_vuc": [
            "Bản quyền tác giả"
          ],
          "ngay_hieu_luc": "2026-10-30",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bfd-ebf7-73db-a734-883ab80e44ab"
        },
        {
          "id": "019d2bfd-ebf6-70b1-b396-d6aae03856ed",
          "ma_tthc": "1.011656",
          "ten_tthc": "Chấp thuận cho tổ chức phi lợi nhuận có hoạt động hoặc chức năng, nhiệm vụ cung cấp dịch vụ cho người khuyết tật trong các lĩnh vực giáo dục, đào tạo, đọc thích nghi và tiếp cận thông tin thực hiện quyền sao chép, phân phối, biểu diễn, truyền đạt tác phẩm dưới định dạng bản sao dễ tiếp cận của tác phẩm",
          "linh_vuc": [
            "Bản quyền tác giả"
          ],
          "ngay_hieu_luc": "2026-10-30",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bfd-ebf6-70b1-b396-d6aae03856ed"
        },

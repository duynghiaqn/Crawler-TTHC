        {
          "id": "019d2bfd-fb9f-722d-9c87-59c519265619",
          "ma_tthc": "2.000752",
          "ten_tthc": "Thủ tục cấp lại Giấy chứng nhận đăng ký quyền liên quan",
          "linh_vuc": [
            "Bản quyền tác giả"
          ],
          "ngay_hieu_luc": "2026-10-30",
          "trang_thai": "PUBLICATION",

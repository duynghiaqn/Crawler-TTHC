{
  "name": "crawler-tthc-backend",
  "version": "2.0.0",
  "description": "Crawler TTHC DVCQG",
  "main": "pipeline/index.js",
  "scripts": {
    "crawl-and-publish": "bash scripts/crawl_and_publish.sh",
    "crawl-and-publish:win": "scripts\\crawl_and_publish.bat",
    "schedule:win": "run.bat schedule",
    "cron:win": "run.bat auto",
    "daemon:win": "run.bat daemon",

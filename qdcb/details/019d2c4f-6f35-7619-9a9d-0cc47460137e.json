        },
        {
          "id": "019d2bfc-e214-77eb-9ff2-0a8fbcdcc5da",
          "ma_tthc": "2.002172",
          "ten_tthc": "Miễn, giảm tiền sử dụng đất đối với dự án nhà ở xã hội, dự án đầu tư hạ tầng nghĩa trang, nghĩa địa",
          "linh_vuc": [
            "Quản lý công sản"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "INACTIVE",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bfc-e214-77eb-9ff2-0a8fbcdcc5da"
        },
        {
          "id": "019d2bfb-e728-7369-8a3b-09df2c03242a",
          "ma_tthc": "1.006341",
          "ten_tthc": "Thủ tục hành chính miễn, giảm tiền thuê đất, thuê mặt nước áp dụng đối với các trường hợp Thủ tướng Chính phủ xem xét, quyết định do Bộ trưởng Bộ Tài chính trình trên cơ sở đề xuất của Bộ trưởng, Thủ trưởng cơ quan ngang Bộ, cơ quan thuộc Chính phủ, Chủ tịch Ủy ban nhân dân cấp tỉnh.",
          "linh_vuc": [
            "Quản lý công sản"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "INACTIVE",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bfb-e728-7369-8a3b-09df2c03242a"
        },
        {
          "id": "019d2bfb-e715-71ae-8096-5adb586067e9",
          "ma_tthc": "1.006414",
          "ten_tthc": "Thủ tục xem xét việc sử dụng quỹ đất của cơ sở nhà, đất thuộc sở hữu nhà nước tại vị trí cũ do cơ quan hành chính, đơn vị sự nghiệp, doanh nghiệp nhà nước thuộc Trung ương quản lý, để thanh toán Dự án BT đầu tư xây dựng công trình tại vị trí mới.",

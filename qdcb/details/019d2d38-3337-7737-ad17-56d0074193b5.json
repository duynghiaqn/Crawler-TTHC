        {
          "id": "019d2bff-06f3-72b8-8ee4-370feddbb374",
          "ma_tthc": "1.004946",
          "ten_tthc": "Áp dụng các biện pháp can thiệp khẩn cấp hoặc tạm thời cách ly trẻ em khỏi môi trường hoặc người gây tổn hại cho trẻ em",
          "linh_vuc": [
            "Trẻ em"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bff-06f3-72b8-8ee4-370feddbb374"
        },
        {
          "id": "019d2bff-061f-74ea-9f1a-7afff1ba691a",
          "ma_tthc": "1.004941",
          "ten_tthc": "Đăng ký nhận chăm sóc thay thế cho trẻ em đối với cá nhân, người đại diện gia đình nhận chăm sóc thay thế không phải là người thân thích của trẻ em",
          "linh_vuc": [
            "Trẻ em"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bff-061f-74ea-9f1a-7afff1ba691a"
        },
        {
          "id": "019d2bff-545f-7218-a5f6-b4660489bb5e",
          "ma_tthc": "2.001942",
          "ten_tthc": "Chuyển trẻ em đang được chăm sóc thay thế tại cơ sở trợ giúp xã hội đến cá nhân, gia đình nhận chăm sóc thay thế",
          "linh_vuc": [
            "Trẻ em"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bff-545f-7218-a5f6-b4660489bb5e"
        },
        {
          "id": "019d2bff-5457-7246-b12e-d42023faa8a7",
          "ma_tthc": "2.001944",
          "ten_tthc": "Thông báo nhận chăm sóc thay thế cho trẻ em đối với cá nhân, người đại diện gia đình nhận chăm sóc thay thế là người thân thích của trẻ em",
          "linh_vuc": [
            "Trẻ em"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bff-5457-7246-b12e-d42023faa8a7"
        },
        {
          "id": "019d2bff-5467-73ae-a00c-a406a8adee22",
          "ma_tthc": "2.001947",
          "ten_tthc": "Phê duyệt kế hoạch hỗ trợ, can thiệp đối với trẻ em bị xâm hại hoặc có nguy cơ bị bạo lực, bóc lột, bỏ rơi và trẻ em có hoàn cảnh đặc biệt",
          "linh_vuc": [
            "Trẻ em"
          ],
          "ngay_hieu_luc": "",
          "trang_thai": "PUBLICATION",
          "url": "https://dichvucong.gov.vn/thu-tuc-hanh-chinh/019d2bff-5467-73ae-a00c-a406a8adee22"
        },
        {
          "id": "019d2bff-061e-754b-9a9b-2d642bcabeb4",
          "ma_tthc": "1.004944",
          "ten_tthc": "Chấm dứt việc chăm sóc thay thế cho trẻ em",
          "linh_vuc": [

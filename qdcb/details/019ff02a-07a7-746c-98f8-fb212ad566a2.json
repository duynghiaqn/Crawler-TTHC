        },
        {
          "id": "019ff00d-ccf8-728a-abc8-62c3333ddb87",
          "ma_tthc": "1.116224",
          "ten_tthc": "Gia hạn sử dụng đất khi hết thời hạn sử dụng đất đối với trường hợp sử dụng đất không thuộc diện chấp thuận chủ trương đầu tư theo pháp luật về đầu tư (cấp xã)",
